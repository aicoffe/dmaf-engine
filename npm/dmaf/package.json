  "description": "D-MAF engine binary (dmaf). Platform binaries are shipped via optionalDependencies (esbuild-style); no download at install time.",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aicoffe/dmaf-engine.git"
  },
  "bin": {
    "dmaf": "bin/dmaf.js"
  },
  "files": [
    "bin/"
  ],
  "engines": {
    "node": ">=14"
  },
  "optionalDependencies": {
    "@aicoffe/dmaf-darwin-arm64": "0.0.0-dev",
    "@aicoffe/dmaf-darwin-x64": "0.0.0-dev",
    "@aicoffe/dmaf-linux-arm64": "0.0.0-dev",
    "@aicoffe/dmaf-linux-x64": "0.0.0-dev",
    "@aicoffe/dmaf-win32-x64": "0.0.0-dev"
  }
}
