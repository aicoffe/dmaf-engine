# .env.example - every environment variable the dmaf project can configure.
# All of them are optional: the engine runs with zero configuration.
# Usage: uncomment what you need, then `set -a; . ./.env.example` (or export manually).

# --- Engine: localization & hooks ---

# Human-facing text language: zh | en.
# Unset: follow the system language (zh* -> zh, otherwise en; detection failure -> en).
# POSIX detection reads LC_ALL > LC_MESSAGES > LANG; Windows uses the user locale.
# `start --locale` bakes the choice into the session; session commands read the
# session, not this variable. Fork inherits the source session's locale.
# export DMAF_LOCALE=zh

# Set to 1 to disable dmaf/hooks.yaml entirely (per-command equivalent: --no-hooks).
# export DMAF_NO_HOOKS=1

# --- Engine: market (dmaf auth / publish / add) ---

# Market base URL. Precedence: --market flag > this variable > credentials file
# [default] market > built-in default below. HTTPS only (plain http accepted for
# localhost only). The install scripts also read it as their download source.
# export DMAF_MARKET_URL=https://dmaf.aicoffe.com

# Personal access token, temporary override for CI scenarios; takes precedence
# over the credentials file and is never persisted to disk.
# export DMAF_MARKET_TOKEN=dmafmt_xxxxxxxxxxxx

# Explicit credentials file path (tests/CI). Defaults:
#   Windows: %APPDATA%\dmaf\credentials.toml
#   Unix:    ~/.config/dmaf/credentials.toml (honors XDG_CONFIG_HOME)
# export DMAF_CREDENTIALS_FILE=/path/to/credentials.toml

# --- Install scripts (curl -fsSL .../install.sh | sh / irm .../install.ps1 | iex) ---

# Target directory for the dmaf binary.
# Defaults: ~/.local/bin (sh) / %LOCALAPPDATA%\Programs\dmaf (PowerShell).
# export DMAF_INSTALL_DIR=~/.local/bin
